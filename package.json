{
  "name": "vite-vue-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint --fix",
    "type-check": "vue-tsc --build --force",
    "ls-lint": "ls-lint --config .ls-lint.yml",
    "format": "prettier --write src/",
    "prepare": "husky",
    "cz": "czg"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/js-cookie": "^3.0.6",
    "@unocss/reset": "0.65.0-beta.2",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vueuse/core": "^12.0.0",
    "element-plus": "https://pkg.pr.new/element-plus/element-plus@72c3ce1",
    "js-cookie": "^3.0.5",
    "pinia": "^2.2.8",
    "pinia-plugin-persistedstate": "^4.1.3",
    "unocss-preset-scrollbar-hide": "^1.0.1",
    "vite-plugin-style-import": "^2.0.0",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/format": "^19.5.0",
    "@eslint/js": "^9.16.0",
    "@imengyu/vue3-context-menu": "^1.4.3",
    "@ls-lint/ls-lint": "^2.2.3",
    "@stylistic/eslint-plugin": "^2.11.0",
    "@types/axios": "^0.14.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/babel-plugin-jsx": "1.2.5",
    "axios": "1.7.8",
    "czg": "^1.11.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "normalize.css": "^8.0.1",
    "prettier": "^3.4.1",
    "sass-embedded": "1.81.0",
    "vue-tsc": "2.0.29",
    "typescript": "5.6.2",
    "typescript-eslint": "^8.16.0",
    "unocss": "0.65.0-beta.2",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-element-plus": "^0.8.0",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.0.1",
    "vite-plugin-vue-devtools": "^7.6.7"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "ls-lint",
      "eslint --fix"
    ]
  }
}
